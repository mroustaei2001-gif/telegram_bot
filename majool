

#!/usr/bin/env python3
"""xui_db.py - ساخت/حذف/پاک‌سازی کلاینت در 3x-UI v3.6.0 بدون API (نوشتن مستقیم DB).
کاربرد: import در ربات تلگرام. نیاز به pip ندارد. باید روی همان سروری اجرا شود
که x-ui روی آن نصب است (چون DB و systemctl و 127.0.0.1:2083 لوکال‌اند)."""
import os, json, time, uuid, random, string, sqlite3, socket, shutil
import subprocess, fcntl, logging
from contextlib import contextmanager
from urllib.parse import quote

log = logging.getLogger("xui_db")

DB     = os.environ.get("XUI_DB", "/etc/x-ui/x-ui.db")
CFG    = os.environ.get("XUI_CFG", "/usr/local/x-ui/bin/config.json")
DOMAIN = os.environ.get("XUI_DOMAIN", "panel.shahinfree.shop")
INBOUND_ID = int(os.environ.get("XUI_INBOUND_ID", "1"))
LOCK   = DB + ".write.lock"
MB = 1024 * 1024

def _rnd(n): return ''.join(random.choices(string.ascii_lowercase + string.digits, k=n))

def vless_link(u, remark="", domain=DOMAIN):
    p = quote("/ws", safe="")
    params = ("encryption=none&security=tls"
              f"&sni={domain}&fp=firefox&alpn=http/1.1"
              f"&type=ws&host={domain}&path={p}")
    return f"vless://{u}@{domain}:443?{params}#{quote(remark or domain)}"

def _row_to_settings_obj(r):
    """یک ردیفِ جدول clients -> آبجکتِ camelCase ای که داخل inbounds.settings می‌نشیند."""
    return {
        "id": r["uuid"], "email": r["email"], "enable": bool(r["enable"]),
        "expiryTime": r["expiry_time"], "limitIp": r["limit_ip"],
        "totalGB": r["total_gb"], "reset": r["reset"],
        "flow": r.get("flow", "") or "", "security": r.get("security", "auto") or "auto",
        "auth": r.get("auth", "") or "", "password": r.get("password", "") or "",
        "subId": r.get("sub_id", "") or "", "tgId": r.get("tg_id", 0) or 0,
        "comment": r.get("comment", "") or "",
    }

def _default_client(u, email, total_gb, days, limit_ip, now):
    return {'email': email, 'sub_id': _rnd(16), 'uuid': u, 'password': _rnd(16),
            'auth': _rnd(16), 'flow': '', 'security': 'auto', 'reverse': '',
            'wg_private_key': '', 'wg_public_key': '', 'wg_allowed_ips': '',
            'wg_pre_shared_key': '', 'wg_keep_alive': 0, 'secret': '', 'ad_tag': '',
            'limit_ip': int(limit_ip), 'total_gb': int(total_gb * MB),
            'expiry_time': 0 if days <= 0 else now + days * 86400 * 1000,
            'enable': 1, 'tg_id': 0, 'group_name': '', 'comment': '', 'reset': 0,
            'created_at': now, 'updated_at': now}

class XuiDB:
    def __init__(self, db=DB, inbound_id=INBOUND_ID, domain=DOMAIN, cfg=CFG):
        self.db, self.iid, self.domain, self.cfg = db, inbound_id, domain, cfg

    # ---- low level ----
    def _listening(self, p):
        try:
            s = socket.create_connection(("127.0.0.1", p), 1); s.close(); return True
        except OSError: return False

    def _wait(self, p, up=True, t=30):
        e = time.time() + t
        while time.time() < e:
            if self._listening(p) == up: return True
            time.sleep(1)
        return False

    def _run(self, c): return subprocess.run(c, capture_output=True, text=True)

    def _cfg_uuids(self):
        try:
            d = json.load(open(self.cfg))
            return [c.get("id") for i in d.get("inbounds", [])
                    for c in i.get("settings", {}).get("clients", [])]
        except Exception: return []

    def _hard_restart(self):
        self._run(["systemctl", "kill", "-s", "SIGKILL", "x-ui"])
        self._wait(2083, False); self._wait(2053, False)
        self._run(["pkill", "-9", "-f", "x-ui"]); time.sleep(1)
        self._run(["systemctl", "reset-failed", "x-ui"])
        self._run(["systemctl", "start", "x-ui"])
        return self._wait(2083, True)

    @contextmanager
    def _lock(self):
        lf = open(LOCK, "w")
        try:
            fcntl.flock(lf, fcntl.LOCK_EX); yield
        finally:
            fcntl.flock(lf, fcntl.LOCK_UN); lf.close()

    def _rows_of_inbound(self, cur):
        cur.execute("SELECT c.* FROM clients c JOIN client_inbounds ci "
                    "ON ci.client_id=c.id WHERE ci.inbound_id=?", (self.iid,))
        cols = [d[0] for d in cur.description]
        return [dict(zip(cols, r)) for r in cur.fetchall()]

    def _sync_settings(self, cur):
        """settings.clients را از جدول clients بازسازی می‌کند (best-effort)."""
        try:
            cur.execute("SELECT settings FROM inbounds WHERE id=?", (self.iid,))
            row = cur.fetchone()
            if not row: return
            s = json.loads(row[0])
            dec = s.get("decryption", "none"); enc = s.get("encryption", "none")
            arr = [_row_to_settings_obj(r) for r in self._rows_of_inbound(cur)]
            new = {"clients": arr, "decryption": dec, "encryption": enc}
            cur.execute("UPDATE inbounds SET settings=? WHERE id=?",
                        (json.dumps(new, ensure_ascii=False), self.iid))
        except Exception as e:
            log.warning("settings sync skipped: %s", e)

    def _reload_and_verify(self, new_uuid):
        up = self._hard_restart()
        in_cfg = new_uuid in self._cfg_uuids()
        if not in_cfg:
            time.sleep(2)
            in_cfg = new_uuid in self._cfg_uuids()
            if not in_cfg:
                self._hard_restart(); time.sleep(2)
                in_cfg = new_uuid in self._cfg_uuids()
        return up, in_cfg

    # ---- public API ----
    def make_config(self, total_gb=500, days=1, limit_ip=1, email=None, reload=True):
        """یک کلاینت می‌سازد و لینک vless برمی‌گرداند.
        برمی‌گرداند: (link, uuid, email, info_dict)."""
        with self._lock():
            con = sqlite3.connect(self.db, timeout=30); con.row_factory = sqlite3.Row
            cur = con.cursor()
            cols = [r[1] for r in cur.execute("PRAGMA table_info(clients)")]
            rows = self._rows_of_inbound(cur)
            sample = dict(rows[0]) if rows else None
            now = int(time.time() * 1000)
            u = str(uuid.uuid4()); email = email or ("u" + _rnd(10))
            base = dict(sample) if sample else _default_client(u, email, total_gb, days, limit_ip, now)
            base.pop('id', None)
            base.update({'uuid': u, 'email': email, 'limit_ip': int(limit_ip),
                         'total_gb': int(total_gb * MB),
                         'expiry_time': 0 if days <= 0 else now + days * 86400 * 1000,
                         'enable': 1, 'created_at': now, 'updated_at': now})
            for k in ('sub_id', 'password', 'auth'):
                if k in base: base[k] = _rnd(16)
            base = {k: v for k, v in base.items() if k in cols}
            bak = self.db + ".bak." + str(int(time.time()))
            bcon = sqlite3.connect(bak); con.backup(bcon); bcon.close()
            try:
                cn = list(base.keys())
                cur.execute("INSERT INTO clients (%s) VALUES (%s)"
                            % (",".join(cn), ",".join("?" * len(cn))), [base[c] for c in cn])
                cid = cur.lastrowid
                cur.execute("INSERT INTO client_inbounds (client_id,inbound_id,flow_override,created_at) "
                            "VALUES (?,?,?,?)", (cid, self.iid, '', now))
                try:
                    cur.execute("INSERT INTO client_traffics (inbound_id,enable,email,up,down,"
                                "expiry_time,total,reset,last_online) VALUES (?,?,?,?,?,?,?,?,?)",
                                (self.iid, 1, email, 0, 0, base['expiry_time'], base['total_gb'], 0, 0))
                except Exception as e: log.warning("client_traffics: %s", e)
                con.commit()
            except Exception:
                con.rollback(); con.close(); os.replace(bak, self.db)
                for ext in ("-wal", "-shm"):
                    try: os.remove(self.db + ext)
                    except OSError: pass
                raise
            try:
                self._sync_settings(cur); con.commit()
            except Exception as e: log.warning("settings sync: %s", e)
            cur.execute("SELECT limit_ip FROM clients WHERE id=?", (cid,))
            lip = cur.fetchone()[0]; con.close()
            up, in_cfg = (True, None)
            if reload: up, in_cfg = self._reload_and_verify(u)
        return vless_link(u, email, self.domain), u, email, \
               {"limit_ip": lip, "xray_up": up, "in_config": in_cfg}

    def delete_client(self, client_uuid, reload=True):
        """یک کلاینت را با uuid پاک می‌کند. True/False."""
        with self._lock():
            con = sqlite3.connect(self.db, timeout=30); cur = con.cursor()
            cur.execute("SELECT id,email FROM clients WHERE uuid=?", (client_uuid,))
            r = cur.fetchone()
            if not r: con.close(); return False
            cid, email = r
            cur.execute("DELETE FROM client_inbounds WHERE client_id=?", (cid,))
            cur.execute("DELETE FROM client_traffics WHERE email=?", (email,))
            cur.execute("DELETE FROM clients WHERE id=?", (cid,))
            con.commit()
            try: self._sync_settings(cur); con.commit()
            except Exception as e: log.warning("settings sync: %s", e)
            con.close()
            if reload: self._hard_restart()
        return True

    def purge_expired(self, reload=True):
        """کلاینت‌های منقضی یا تمام‌حجم را پاک می‌کند. تعدادِ پاک‌شده را برمی‌گرداند."""
        now = int(time.time() * 1000); removed = 0
        with self._lock():
            con = sqlite3.connect(self.db, timeout=30); cur = con.cursor()
            cur.execute("SELECT c.id,c.email,c.expiry_time,c.up,c.down,c.total_gb "
                        "FROM clients c JOIN client_inbounds ci ON ci.client_id=c.id "
                        "WHERE ci.inbound_id=?", (self.iid,))
            todo = [(cid, em) for (cid, em, exp, up, dn, tot) in cur.fetchall()
                    if (exp and exp > 0 and exp < now) or (tot and tot > 0 and (up + dn) >= tot)]
            for cid, email in todo:
                cur.execute("DELETE FROM client_inbounds WHERE client_id=?", (cid,))
                cur.execute("DELETE FROM client_traffics WHERE email=?", (email,))
                cur.execute("DELETE FROM clients WHERE id=?", (cid,))
                removed += 1
            if removed:
                con.commit()
                try: self._sync_settings(cur); con.commit()
                except Exception as e: log.warning("settings sync: %s", e)
            con.close()
            if removed and reload: self._hard_restart()
        return removed

if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(name)s: %(message)s")
    api = XuiDB()
    link, u, e, info = api.make_config(500, 1, limit_ip=1)
    print("EMAIL:", e); print("UUID :", u); print("LINK :", link); print("INFO :", info)
